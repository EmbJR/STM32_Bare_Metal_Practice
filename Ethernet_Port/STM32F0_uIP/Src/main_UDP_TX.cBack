volatile uint32_t timerTickCount = 0;

ENC28J60_ConfigTypeDef encdevice = {
    .full_duplex = true,
    .auto_negotiation = false,
};
struct uip_eth_addr my_mac = {{0x00, 0x04, 0xA3, 0x11, 0x22, 0x33}};

