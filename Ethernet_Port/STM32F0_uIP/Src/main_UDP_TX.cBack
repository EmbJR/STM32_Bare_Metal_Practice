#endif

void Delay_ms(uint32_t ms)
{
    volatile uint32_t i, j;
    for (i = 0; i < ms; i++)
    {
        for (j = 0; j < 8000; j++)
        {
            //__NOP();
        }
    }
}

// Example configuration for 48MHz system clock using PLL from HSE
void SystemClock_Config_48MHz(void)
{
    RCC_Config rcc_config;

    /* Configure RCC for 48MHz using PLL with HSI */
    rcc_config.system_clock_source = CLOCK_SOURCE_PLL;
    rcc_config.target_frequency = SYSTEM_CLOCK_48MHZ;
    rcc_config.hse_enabled = false;
    rcc_config.pll_enabled = true;
    rcc_config.pll_source = PLL_SOURCE_HSI_DIV2;
    rcc_config.pll_multiplier = 12; /* HSI (8MHz/2) * 12 = 48MHz */
    rcc_config.ahb_prescaler = AHB_PRESCALER_1;
    rcc_config.apb_prescaler = APB_PRESCALER_1;
    rcc_config.hsi48_enabled = false;
    rcc_config.css_enabled = false;

    /* Initialize RCC */
    RCC_Init(&rcc_config);
}

/*============================================================================
 * Example 1: LED Blink (GPIO Output)
 *============================================================================*/
void Example_LED_Blink(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    /* Enable GPIOC clock for LED on PC8 */
    GPIO_EnableClock(GPIOC);

    /* Configure PC8 as output */
    GPIO_InitStruct.Pin = GPIO_PIN_8;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT;
    GPIO_InitStruct.Ot = GPIO_OTYPE_PP;
    GPIO_InitStruct.Speed = GPIO_SPEED_LOW;
    GPIO_InitStruct.Pull = GPIO_PULL_NO;
    GPIO_Init(GPIOC, &GPIO_InitStruct);
    GPIO_InitStruct.Pin = GPIO_PIN_9;
    GPIO_Init(GPIOC, &GPIO_InitStruct);
}

clock_time_t clock_time(void)
{
    return timerTickCount;
}

static void Timer2_Callback(void)
{
    timerTickCount++;
    if (timerTickCount % 100 == 0)
    {
        GPIO_TogglePin(GPIOC, GPIO_PIN_8);
    }
}

void initializaTimer(void)
{
    uint32_t t2clk = STM32F0Timer_GetTimerClockHz(TIMER2);
    // TIMER2: 1 second = 1,000,000 us (1 Hz)
    if (!STM32F0Timer_ConfigurePeriodUs(TIMER2, t2clk, 10000))
    {
        while (1)
            ;
    }

    STM32F0Timer_SetUpdateCallback(TIMER2, Timer2_Callback);

    // Enable update interrupts (NVIC priority in helper)
    STM32F0Timer_EnableUpdateInterrupt(TIMER2, true);

    // Start timers
    STM32F0Timer_Start(TIMER2);
}

//------------------------------- uIP related -------------------------------//
#define BUF ((struct uip_eth_hdr *)&uip_buf[0])

static struct uip_udp_conn *broadcast_conn;
static volatile uint8_t send_flag = 0;

/* ------------------------------------------------------------------------- */
/* UDP Application Callback                                                  */
/* ------------------------------------------------------------------------- */
void udp_broadcast_appcall(void)
{
    // Check if uIP is polling this connection and if we requested a send
    if (uip_poll() && send_flag)
    {
        send_flag = 0; // Clear the trigger flag

        // Send the payload
        uip_send("Hello From uc\n\r", 13);
    }
}

uint16_t network_device_read(void)
{
    volatile uint16_t len = 0;
    len = getPackatLen();
    if ((len > 0) && (len < UIP_CONF_BUFFER_SIZE))
    {
        ENC28J60_ReceivePacket(uip_buf, len);
        return len;
    }
    else if (len > UIP_CONF_BUFFER_SIZE)
    {
        ENC28J60_DiscardRxPacket();
        return 0;
    }
    else
    {
        return 0;
    }
}

void network_device_send()
{
    ENC28J60_SendPacket(uip_buf, uip_len);
}

void example_app_call(void)
{
    if (uip_connected())
    {
        // A new TCP connection has been established
    }

    if (uip_newdata())
    {
        // Data received! Read buffer from uip_appdata
        // Example: Echoing received data back
        uip_send(uip_appdata, uip_datalen());
    }

    if (uip_acked())
    {
        // Previously sent data was acknowledged by the remote host
    }

    if (uip_closed() || uip_aborted() || uip_timedout())
    {
        // Connection closed or lost
    }
}

void uip_log(char *msg)
{
    UART_SendStringIT(USART1, msg);
}

