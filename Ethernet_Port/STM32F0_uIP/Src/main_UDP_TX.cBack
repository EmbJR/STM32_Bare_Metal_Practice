/* ------------------------------------------------------------------------- */
/* Main Program Setup & Event Loop                                           */
/* ------------------------------------------------------------------------- */
int main(void)
{
	int i, cnt = 0;
    uip_ipaddr_t ipaddr;
    struct timer periodic_timer, arp_timer;

    SystemClock_Config_48MHz();
    Delay_ms(30);
    Example_LED_Blink();
    uart1_initialize();
    initializaTimer();
    // 1. Initialize Low-level Hardware Driver & uIP Stack
    // (Ensure SPI and ENC28J60 hardware initialization routines are executed)
    //-----------------------------------------------------//
    encdevice.mac_addr[0] = my_mac.addr[0];
    encdevice.mac_addr[1] = my_mac.addr[1];
    encdevice.mac_addr[2] = my_mac.addr[2];
    encdevice.mac_addr[3] = my_mac.addr[3];
    encdevice.mac_addr[4] = my_mac.addr[4];
    encdevice.mac_addr[5] = my_mac.addr[5];

    ENC28J60_Init(&encdevice);
    uip_setethaddr(my_mac);

    //------------- uip setup -------------------//
    timer_set(&periodic_timer, CLOCK_SECOND / 2);
    timer_set(&arp_timer, CLOCK_SECOND * 10);

    uip_init();

    // 2. Set Local Static IP Address (e.g., 192.168.1.150)
    uip_ipaddr(ipaddr, 192, 168, 29, 111);
    uip_sethostaddr(ipaddr);

    // Set Netmask (255.255.255.0)
    uip_ipaddr(ipaddr, 255, 255, 255, 0);
    uip_setnetmask(ipaddr);

    // 3. Set Broadcast IP Address (255.255.255.255)
    uip_ipaddr(ipaddr, 255, 255, 255, 255);

    // 4. Create UDP Connection to Broadcast IP on Port 5050
    broadcast_conn = uip_udp_new(&ipaddr, HTONS(5051));
    if (broadcast_conn != NULL)
    {
        // Optionally bind local port (e.g., 5050)
        uip_udp_bind(broadcast_conn, HTONS(5051));
    }
    //-----------------------------------------------//

    // 5. Main Loop
    while (1)
    {
        uip_len = network_device_read();
        if (uip_len > 0)
        {
            if (BUF->type == htons(UIP_ETHTYPE_IP))
            {
                uip_arp_ipin();
                uip_input();
                /* If the above function invocation resulted in data that
                   should be sent out on the network, the global variable
                   uip_len is set to a value > 0. */
                if (uip_len > 0)
                {
                    uip_arp_out();
                    network_device_send();
                }
            }
            else if (BUF->type == htons(UIP_ETHTYPE_ARP))
            {
                uip_arp_arpin();
                /* If the above function invocation resulted in data that
                   should be sent out on the network, the global variable
                   uip_len is set to a value > 0. */
                if (uip_len > 0)
                {
                    network_device_send();
                }
            }
        }
        else if (timer_expired(&periodic_timer))
        {
            timer_reset(&periodic_timer);
            for (i = 0; i < UIP_CONNS; i++)
            {
                uip_periodic(i);
                /* If the above function invocation resulted in data that
                   should be sent out on the network, the global variable
                   uip_len is set to a value > 0. */
                if (uip_len > 0)
                {
                    uip_arp_out();
                    network_device_send();
                }
            }

#if UIP_UDP
            for (i = 0; i < UIP_UDP_CONNS; i++)
            {
                uip_udp_periodic(i);
                /* If the above function invocation resulted in data that
                   should be sent out on the network, the global variable
                   uip_len is set to a value > 0. */
                if (uip_len > 0)
                {
                    uip_arp_out();
                    network_device_send();
                }
            }
#endif /* UIP_UDP */

            /* Call the ARP timer function every 10 seconds. */
            if (timer_expired(&arp_timer))
            {
                timer_reset(&arp_timer);
                uip_arp_timer();
            }
        }
        if(cnt++ > 50)
        {
            cnt = 0;
            send_flag = 1;
        }
        Delay_ms(50);
    }
}
